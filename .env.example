POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=red_antiextorsion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Required to start the API: supply a random secret of at least 32 bytes.
# There is deliberately no default/development signing secret.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=red-antiextorsion-preventiva
JWT_AUDIENCE=red-antiextorsion-api
